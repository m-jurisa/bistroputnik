{
  "name": "bistroputnik",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run prices:publish && npm run prices:verify && next build --webpack && node scripts/prune-static-export.mjs && node scripts/publish-prices.mjs --verify-export",
    "build:final": "npm run build",
    "build:next": "npm run prices:publish && npm run prices:verify && next build --webpack && node scripts/publish-prices.mjs --verify-export",
    "prices:publish": "node scripts/publish-prices.mjs",
    "marenda:publish": "node scripts/publish-prices.mjs",
    "prices:verify": "node scripts/publish-prices.mjs --verify",
    "test": "node --test tests/*.test.mjs",
    "generate:marenda-story": "node scripts/generate-marenda-story.mjs",
    "generate:social-carousels": "node scripts/generate-social-carousels.mjs",
    "generate:social-dish": "node scripts/generate-social-dish.mjs",
    "prune:export": "node scripts/prune-static-export.mjs",
    "start": "node server/static-server.mjs",
    "start:ssg": "node server/static-server.mjs"
  },
  "dependencies": {
    "next": "^16.2.3",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "autoprefixer": "10.4.20",
    "postcss": "8.4.41",
    "sharp": "^0.34.5",
    "tailwindcss": "3.4.10"
  }
}
